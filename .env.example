# ─── DATABASE (Required) ───
DATABASE_URL="postgresql://postgres:password@host:6543/db?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@host:5432/db"

# ─── AUTHENTICATION (Required) ───
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://your-domain.vercel.app"

# ─── CLOUDFLARE TURNSTILE (Required) ───
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAA..."
TURNSTILE_SECRET_KEY="0x4AAAA..."

# ─── EMAIL (Gmail SMTP — Required for password reset & email verification) ───
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
EMAIL_FROM="BillForge <your-email@gmail.com>"

# ─── UPSTASH REDIS (Optional — falls back to DB-backed rate limiting) ───
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN=""
