# ─── DATABASE (Required) ───
# Neon/Supabase pooled connection (pgBouncer) for app runtime.
DATABASE_URL="postgresql://user:password@host:6543/db?pgbouncer=true&sslmode=require"
# Direct (non-pooled) connection for migrations only.
DIRECT_URL="postgresql://user:password@host:5432/db?sslmode=require"

# ─── AUTHENTICATION (Required) ───
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://your-domain.vercel.app"

# ─── SITE / SEO (Optional — falls back to NEXTAUTH_URL) ───
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"

# ─── CLOUDFLARE TURNSTILE (Required for register/login bot protection) ───
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAA..."
TURNSTILE_SECRET_KEY="0x4AAAA..."

# ─── EMAIL (Gmail SMTP — Required for password reset & verification) ───
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
EMAIL_FROM="BillForge <your-email@gmail.com>"

# ─── UPSTASH REDIS (Optional — DB-backed rate limiting used as fallback) ───
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
